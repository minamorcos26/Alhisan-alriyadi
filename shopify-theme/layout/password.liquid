<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap">
  {{ settings.font_display | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_face: font_display: 'swap' }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --color-background: {{ settings.color_background }};
      --color-ink: {{ settings.color_ink }};
      --color-accent: {{ settings.color_accent }};
      --font-display: {{ settings.font_display.family }}, sans-serif;
      --font-body: {{ settings.font_body.family }}, sans-serif;
    }
    .password-page {
      min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: var(--space-6, 32px); text-align: center; padding: var(--space-5, 24px);
    }
    .password-form { display: flex; gap: var(--space-2, 8px); flex-wrap: wrap; justify-content: center; }
    .password-form input { min-height: 48px; padding-inline: 16px; border: 1px solid var(--color-border, #E5E5E5); border-radius: 4px; font-size: 1rem; }
  </style>
</head>
<body>
  <div class="password-page">
    <div class="logo">{{ shop.name }}</div>
    {%- form 'storefront_password' -%}
      <div class="password-form">
        <input type="password" name="password" placeholder="{{ 'general.password_page.password' | t }}" required>
        <button type="submit" class="btn btn-primary">{{ 'general.password_page.enter' | t }}</button>
      </div>
      {%- if form.errors -%}
        <p style="color: var(--color-accent);">{{ form.errors.messages['form'] }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
  {{ content_for_layout }}
</body>
</html>
