<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <title>
    {{ page_title }}
    {%- if current_page != 1 %} &ndash; {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- comment -%} Tell Google which locale/URL pairs are equivalent so it serves the Arabic pages to Saudi searchers instead of treating en/ar as duplicate content. {%- endcomment -%}
  {%- for language in localization.available_languages -%}
    <link rel="alternate" hreflang="{{ language.iso_code }}" href="{{ request.origin }}{{ language.root_url }}{{ request.path | remove_first: language.root_url }}">
  {%- endfor -%}
  <link rel="alternate" hreflang="x-default" href="{{ request.origin }}{{ request.path }}">

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  <meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta name="twitter:description" content="{{ page_description | escape }}">{% endif %}

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "OnlineStore",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "logo": {% if settings.logo %}{{ settings.logo | image_url: width: 300 | prepend: 'https:' | json }}{% else %}null{% endif %},
      "areaServed": "SA",
      "sameAs": [
        {%- liquid
          assign printed_link = false
        -%}
        {%- if settings.social_instagram_link != blank -%}{{ settings.social_instagram_link | json }}{% assign printed_link = true %}{%- endif -%}
        {%- if settings.social_facebook_link != blank -%}{% if printed_link %},{% endif %}{{ settings.social_facebook_link | json }}{% assign printed_link = true %}{%- endif -%}
        {%- if settings.social_x_link != blank -%}{% if printed_link %},{% endif %}{{ settings.social_x_link | json }}{% assign printed_link = true %}{%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}{% if printed_link %},{% endif %}{{ settings.social_tiktok_link | json }}{% assign printed_link = true %}{%- endif -%}
        {%- if settings.social_snapchat_link != blank -%}{% if printed_link %},{% endif %}{{ settings.social_snapchat_link | json }}{% assign printed_link = true %}{%- endif -%}
      ]
    }
  </script>

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap">

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    {{ settings.font_display | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}

    :root {
      --color-background: {{ settings.color_background }};
      --color-background-alt: {{ settings.color_background_alt }};
      --color-ink: {{ settings.color_ink }};
      --color-ink-soft: {{ settings.color_ink_soft }};
      --color-border: {{ settings.color_border }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-dark: {{ settings.color_accent_dark }};
      --color-accent-soft: {{ settings.color_accent_soft }};
      --font-display: {{ settings.font_display.family }}, sans-serif;
      --font-body: {{ settings.font_body.family }}, sans-serif;
      --container-max: {{ settings.page_width }}px;
    }
  </style>

  <script>window.themeMoneyFormat = {{ shop.money_format | json }};</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ template.name | handleize }}">
  <a href="#main" class="skip-link">{{ 'general.a11y.skip_to_content' | t }}</a>

  {% section 'announcement-bar' %}
  {% section 'header' %}
  {%- render 'cart-drawer' -%}

  <main id="main">
    {{ content_for_layout }}
  </main>

  {% section 'newsletter' %}
  {% section 'footer' %}
</body>
</html>
