{%- comment -%}
  Accepts: name
{%- endcomment -%}
{%- case name -%}
  {%- when 'all' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
  {%- when 'sale' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2 2 12l10 10 10-10z"/><circle cx="9" cy="9" r="1.4" fill="currentColor" stroke="none"/></svg>
  {%- when 'new' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/><circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none"/></svg>
  {%- when 'men' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="7" r="4"/><path stroke-linecap="round" d="M5 21c1.5-4.5 5-6.5 7-6.5s5.5 2 7 6.5"/></svg>
  {%- when 'women' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="7" r="4"/><path stroke-linecap="round" d="M12 11v7m-3.5-3h7"/></svg>
  {%- when 'kids' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="6" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 21v-5.5a5 5 0 0 1 10 0V21"/></svg>
  {%- when 'football' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="m12 7 4 3-1.5 4.5h-5L8 10z"/></svg>
  {%- when 'water' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M2 16c1.5 1.5 3 1.5 4.5 0s3-1.5 4.5 0 3 1.5 4.5 0 3-1.5 4.5 0M2 20c1.5 1.5 3 1.5 4.5 0s3-1.5 4.5 0 3 1.5 4.5 0 3-1.5 4.5 0"/><path stroke-linecap="round" d="M12 3v9"/><circle cx="12" cy="3" r="1.4" fill="currentColor" stroke="none"/></svg>
  {%- when 'beach' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21c4-8 14-8 18 0"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 12V3"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 5c3 0 5 2 5 2s-2 2-5 2-5-2-5-2 2-2 5-2Z"/></svg>
  {%- when 'gym' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8v8M20 8v8M7 12h10M2 10v4M22 10v4"/></svg>
  {%- when 'racket' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="9" cy="8" rx="6" ry="7"/><path stroke-linecap="round" d="m13.5 12.5 7 7"/></svg>
  {%- when 'shoes' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 17h17a2 2 0 0 0 2-2c0-1-1-1.5-2-2l-3-1-3-4-4 1v4l-4 1c-2 .5-3 1.5-3 3z"/></svg>
  {%- when 'star-outline' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linejoin="round" d="m12 3.5 2.65 5.37 5.93.86-4.29 4.18 1.01 5.9L12 17l-5.3 2.81 1.01-5.9-4.29-4.18 5.93-.86Z"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/></svg>
{%- endcase -%}
