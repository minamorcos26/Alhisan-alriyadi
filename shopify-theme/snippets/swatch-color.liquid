{%- comment -%}
  Accepts: value (a variant option value string, e.g. "Navy Blue")
  Maps common color-option words to a real CSS color for swatch rendering.
{%- endcomment -%}
{%- assign v = value | downcase | strip -%}
{%- case v -%}
  {%- when 'black' -%}#111111
  {%- when 'white' -%}#ffffff
  {%- when 'gray', 'grey' -%}#9a9a9a
  {%- when 'dark gray', 'dark grey', 'charcoal' -%}#3f3f3f
  {%- when 'navy', 'navy blue' -%}#1c2b4a
  {%- when 'blue' -%}#2f6fd1
  {%- when 'light blue', 'sky blue' -%}#7fb8e6
  {%- when 'red' -%}#c0392b
  {%- when 'orange' -%}#e07b28
  {%- when 'yellow' -%}#f0c419
  {%- when 'green' -%}#2f7d3c
  {%- when 'olive green', 'olive' -%}#6b7a3a
  {%- when 'pink' -%}#e78bb0
  {%- when 'purple' -%}#7c4fa0
  {%- when 'brown' -%}#7a4b2a
  {%- when 'beige' -%}#e3d6bd
  {%- when 'gold' -%}#c9a94a
  {%- when 'silver' -%}#c4c4c4
  {%- when 'multicolor', 'multi', 'multi color' -%}linear-gradient(135deg, #e0403b 0%, #f0c419 33%, #2f6fd1 66%, #2f7d3c 100%)
  {%- else -%}#b9b9b9
{%- endcase -%}
