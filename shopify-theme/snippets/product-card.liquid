{%- comment -%}
  Accepts: product (required)
{%- endcomment -%}

<article class="product-card">
  <a href="{{ product.url }}" class="product-card__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag:
        loading: 'lazy',
        widths: '300,450,600',
        alt: product.featured_image.alt | default: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    {%- if product.compare_at_price > product.price -%}
      <span class="product-card__badge product-card__badge--sale">{{ 'sections.main_collection.on_sale' | t }}</span>
    {%- endif -%}
    {%- unless product.available -%}
      <span class="product-card__badge">{{ 'sections.product.sold_out' | t }}</span>
    {%- endunless -%}

    <span class="product-card__zoom-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/><path stroke-linecap="round" d="M11 8v6M8 11h6"/></svg>
    </span>
  </a>
  <a href="{{ product.url }}" class="product-card__link">
    <span class="product-card__type">{{ product.type }}</span>
    <h3 class="product-card__title">{{ product.title }}</h3>
    <div class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <s class="product-card__compare">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
      {%- endif -%}
      {{ product.price | money_without_trailing_zeros }}
    </div>
  </a>

  {%- if product.available -%}
    {%- form 'product', product, class: 'product-card__form' -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="product-card__cart-btn" data-added-label="{{ 'sections.product.added' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 12.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="9" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>
        {{ 'sections.product.add_to_cart' | t }}
      </button>
    {%- endform -%}
  {%- else -%}
    <button type="button" class="product-card__cart-btn" disabled>{{ 'sections.product.sold_out' | t }}</button>
  {%- endif -%}
</article>
