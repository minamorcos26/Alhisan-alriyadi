{%- comment -%}
  Accepts: product (required)
{%- endcomment -%}

<article class="product-card">
  <a href="{{ product.url }}" class="product-card__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag:
        loading: 'lazy',
        widths: '300,450,600',
        alt: product.featured_image.alt | default: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    {%- if product.compare_at_price > product.price -%}
      <span class="product-card__badge product-card__badge--sale">{{ 'sections.main_collection.on_sale' | t }}</span>
    {%- endif -%}
    {%- unless product.available -%}
      <span class="product-card__badge">{{ 'sections.product.sold_out' | t }}</span>
    {%- endunless -%}

    <div class="product-card__quick">
      {%- if product.available -%}
        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn btn-primary btn-sm btn-block">{{ 'sections.product.add_to_cart' | t }}</button>
        {%- endform -%}
      {%- else -%}
        <span class="btn btn-ghost btn-sm btn-block">{{ 'sections.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>
  </a>
  <a href="{{ product.url }}" class="product-card__link">
    <span class="product-card__type">{{ product.type }}</span>
    <h3 class="product-card__title">{{ product.title }}</h3>
    <div class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <s class="product-card__compare">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
      {%- endif -%}
      {{ product.price | money_without_trailing_zeros }}
    </div>
  </a>
</article>
