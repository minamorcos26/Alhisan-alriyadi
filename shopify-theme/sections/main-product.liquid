<div class="container">
  <div class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
    {%- if product.collections.first -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
    {%- endif -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
    <span class="current">{{ product.title }}</span>
  </div>
</div>

<div class="container product-detail" data-product-root>
  <script type="application/json" data-product-json>{{ product | json | replace: '</script>', '<\/script>' }}</script>
  <div class="product-detail__media">
    <div class="product-detail__main-image">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__badge product-card__badge--sale">{{ 'sections.main_collection.on_sale' | t }}</span>
      {%- endif -%}
      {%- unless product.available -%}
        <span class="product-card__badge">{{ 'sections.product.sold_out' | t }}</span>
      {%- endunless -%}

      {%- if product.featured_image -%}
        {%- liquid
          assign featured_alt = product.featured_image.alt | default: product.title
          assign zoom_src = product.featured_image | image_url: width: 2000
        -%}
        {{ product.featured_image | image_url: width: 1200 | image_tag:
          widths: '600,900,1200',
          alt: featured_alt,
          loading: 'eager',
          data-zoom-src: zoom_src
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      <button type="button" class="product-detail__zoom-btn" data-zoom-trigger aria-label="{{ 'sections.product.zoom' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        {{ 'sections.product.tap_zoom' | t }}
      </button>
    </div>

    {%- if product.images.size > 1 -%}
      <div class="product-detail__thumbs">
        {%- for image in product.images limit: 8 -%}
          <button type="button" class="product-detail__thumb{% if forloop.first %} is-active{% endif %}" data-thumb data-src="{{ image | image_url: width: 1200 }}">
            {{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: image.alt }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-detail__info">
    {%- if product.vendor != blank -%}<span class="product-detail__vendor">{{ product.vendor }}</span>{%- endif -%}
    <h1>{{ product.title }}</h1>
    <div class="product-detail__price">
      {%- if product.compare_at_price > product.price -%}
        <s class="product-card__compare">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
      {%- endif -%}
      <span>{{ product.price | money_without_trailing_zeros }}</span>
    </div>

    {%- form 'product', product, class: 'product-detail__form' -%}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_name_down = option.name | downcase -%}
          {%- assign is_color = false -%}
          {%- assign is_size = false -%}
          {%- if option_name_down == 'color' or option_name_down == 'colour' or option.name == 'اللون' -%}
            {%- assign is_color = true -%}
          {%- elsif option_name_down == 'size' or option.name == 'المقاس' or option.name == 'القياس' -%}
            {%- assign is_size = true -%}
          {%- endif -%}

          <div class="product-option">
            <div class="product-option__head">
              <label class="product-option__label">
                {{ option.name }}{% if is_color %}: <span data-selected-label>{{ option.selected_value }}</span>{% endif %}
              </label>
              {%- if is_size -%}
                <button type="button" class="size-guide-trigger" data-size-guide-trigger>{{ 'sections.product.size_guide' | t }}</button>
              {%- endif -%}
            </div>

            {%- if is_color -%}
              <div class="product-option__swatches">
                {%- for value in option.values -%}
                  <button type="button"
                    class="swatch{% if option.selected_value == value %} is-selected{% endif %}"
                    data-option-name="{{ option.name | escape }}"
                    data-value="{{ value | escape }}"
                    aria-label="{{ value }}"
                    title="{{ value }}">
                    <span class="swatch__fill" style="background: {% render 'swatch-color', value: value %};"></span>
                  </button>
                {%- endfor -%}
              </div>
            {%- elsif is_size -%}
              <div class="product-option__chips">
                {%- for value in option.values -%}
                  <button type="button"
                    class="chip-option{% if option.selected_value == value %} is-selected{% endif %}"
                    data-option-name="{{ option.name | escape }}"
                    data-value="{{ value | escape }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            {%- else -%}
              <select name="options[{{ option.name | escape }}]" class="select">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            {%- endif -%}
          </div>
        {%- endfor -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
      {%- else -%}
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
      {%- endunless -%}

      <div class="product-detail__actions">
        <div class="product-detail__buy-row">
          <div class="qty-stepper">
            <button type="button" class="qty-stepper__btn" data-qty-decrease aria-label="Decrease quantity">&minus;</button>
            <input type="number" id="Quantity" name="quantity" value="1" min="1" class="qty-stepper__input">
            <button type="button" class="qty-stepper__btn" data-qty-increase aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="btn btn-primary product-detail__buy-btn" data-add-to-cart
            data-label-available="{{ 'sections.product.add_to_cart' | t }}"
            data-label-unavailable="{{ 'sections.product.sold_out' | t }}"
            {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}{{ 'sections.product.add_to_cart' | t }}{%- else -%}{{ 'sections.product.sold_out' | t }}{%- endif -%}
          </button>
        </div>
        {%- if product.available -%}
          {{ form | payment_button }}
        {%- endif -%}
      </div>
    {%- endform -%}

    <div class="product-detail__trust">
      <div class="value-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
        <div><strong>{{ 'sections.value_props.delivery_title' | t }}</strong><span>{{ 'sections.value_props.delivery_text' | t }}</span></div>
      </div>
      <div class="value-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3"/><path stroke-linecap="round" stroke-linejoin="round" d="M18 3v4h-4M6 21v-4h4"/></svg>
        <div><strong>{{ 'sections.value_props.returns_title' | t }}</strong><span>{{ 'sections.value_props.returns_text' | t }}</span></div>
      </div>
    </div>

    {%- if product.description != blank -%}
      <div class="product-detail__description">
        <h2>{{ 'sections.product.description' | t }}</h2>
        {{ product.description }}
      </div>
    {%- endif -%}
  </div>
</div>

<div class="sticky-atc" data-sticky-atc>
  <div class="container sticky-atc__inner">
    <div class="sticky-atc__media">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 120 | image_tag: alt: product.title, loading: 'lazy' }}
      {%- endif -%}
    </div>
    <div class="sticky-atc__info">
      <span class="sticky-atc__title">{{ product.title }}</span>
      <span class="sticky-atc__price">{{ product.price | money_without_trailing_zeros }}</span>
    </div>
    <button type="button" class="btn btn-primary sticky-atc__btn" data-sticky-atc-btn {% unless product.available %}disabled{% endunless %}>
      {%- if product.available -%}{{ 'sections.product.add_to_cart' | t }}{%- else -%}{{ 'sections.product.sold_out' | t }}{%- endif -%}
    </button>
  </div>
</div>


<div class="zoom-overlay" data-zoom-overlay>
  <button type="button" class="zoom-overlay__close" aria-label="{{ 'general.header.close_menu' | t }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
  <img data-zoom-image alt="{{ product.title }}">
</div>

<div class="size-guide-overlay" data-size-guide-overlay>
  <div class="size-guide-modal">
    <button type="button" class="size-guide-modal__close" data-size-guide-close aria-label="{{ 'general.header.close_menu' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <h3>{{ 'sections.product.size_guide_heading' | t }}</h3>
    <table class="size-guide-table">
      <thead>
        <tr>
          <th>{{ 'sections.product.size_guide_col_size' | t }}</th>
          <th>{{ 'sections.product.size_guide_col_chest' | t }}</th>
          <th>{{ 'sections.product.size_guide_col_waist' | t }}</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>XS</td><td>82&ndash;86</td><td>66&ndash;70</td></tr>
        <tr><td>S</td><td>87&ndash;91</td><td>71&ndash;75</td></tr>
        <tr><td>M</td><td>92&ndash;97</td><td>76&ndash;81</td></tr>
        <tr><td>L</td><td>98&ndash;104</td><td>82&ndash;89</td></tr>
        <tr><td>XL</td><td>105&ndash;111</td><td>90&ndash;97</td></tr>
        <tr><td>XXL</td><td>112&ndash;118</td><td>98&ndash;105</td></tr>
      </tbody>
    </table>
    <p class="size-guide-modal__note">{{ 'sections.product.size_guide_note' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Product information",
  "settings": []
}
{% endschema %}
