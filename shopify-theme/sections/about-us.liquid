{%- liquid
  assign heading = section.settings.heading | default: 'sections.about.heading' | t
  assign intro = section.settings.intro | default: 'sections.about.intro' | t
  assign founded_year = section.settings.founded_year | default: 2025
-%}

<div class="about-hero">
  <div class="container about-hero__inner">
    <span class="about-hero__eyebrow">{{ 'sections.about.eyebrow' | t }}</span>
    <h1>{{ heading }}</h1>
    <p class="about-hero__intro">{{ intro }}</p>
    <div class="about-hero__stats">
      <div class="about-hero__stat">
        <b>{{ founded_year }}</b>
        <span>{{ 'sections.about.since_label' | t }}</span>
      </div>
      <div class="about-hero__stat">
        <b>{{ 'sections.about.location_value' | t }}</b>
        <span>{{ 'sections.about.location_label' | t }}</span>
      </div>
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <div class="container about-gear">
    <h2 class="about-gear__heading">{{ 'sections.about.gear_heading' | t }}</h2>
    <p class="about-gear__text">{{ 'sections.about.gear_text' | t }}</p>
    <div class="about-gear__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign default_label = 'sections.about.gear_' | append: block.settings.icon | t
          assign gear_coll = collections[block.settings.collection]
        -%}
        {%- if gear_coll -%}<a href="{{ gear_coll.url }}" class="about-gear__item" {{ block.shopify_attributes }}>{%- else -%}<div class="about-gear__item" {{ block.shopify_attributes }}>{%- endif -%}
          <span class="about-gear__icon" aria-hidden="true">{%- render 'icon', name: block.settings.icon -%}</span>
          <span class="about-gear__label">{{ block.settings.label | default: default_label }}</span>
        {%- if gear_coll -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "About us",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the default bilingual heading." },
    { "type": "textarea", "id": "intro", "label": "Intro text", "info": "Leave blank to use the default bilingual intro." },
    { "type": "number", "id": "founded_year", "label": "Founded year", "default": 2025 }
  ],
  "blocks": [
    {
      "type": "gear_item",
      "name": "Gear item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shirt", "label": "Shirt" },
            { "value": "shorts", "label": "Shorts" },
            { "value": "backpack", "label": "Backpack" },
            { "value": "medal", "label": "Medal" },
            { "value": "trophy", "label": "Trophy" },
            { "value": "flag", "label": "Flag" }
          ],
          "default": "shirt"
        },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave blank to use the default bilingual label for the icon." },
        { "type": "collection", "id": "collection", "label": "Linked collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About us",
      "blocks": [
        { "type": "gear_item", "settings": { "icon": "shirt", "collection": "shirts" } },
        { "type": "gear_item", "settings": { "icon": "shorts", "collection": "men-shorts" } },
        { "type": "gear_item", "settings": { "icon": "backpack", "collection": "bags-backpacks" } },
        { "type": "gear_item", "settings": { "icon": "medal", "collection": "trophy-cups-medals" } },
        { "type": "gear_item", "settings": { "icon": "trophy", "collection": "trophy-cups-medals" } },
        { "type": "gear_item", "settings": { "icon": "flag", "collection": "flags" } }
      ]
    }
  ]
}
{% endschema %}
