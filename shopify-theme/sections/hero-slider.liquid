<section class="hero-slider" data-hero-slider {% if section.blocks.size > 1 %}data-autoplay="5000"{% endif %}>
  <div class="hero-slider__viewport">
    <div class="hero-slider__track" data-slider-track>
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        {%- assign slide_image = block.settings.image | default: coll.image | default: coll.products.first.featured_image -%}
        {%- assign slide_alt = block.settings.heading | default: coll.title -%}
        {%- assign loading_attr = 'lazy' -%}
        {%- if forloop.first -%}{%- assign loading_attr = 'eager' -%}{%- endif -%}
        <a href="{{ coll.url | default: routes.all_products_collection_url }}" class="hero-slide" {{ block.shopify_attributes }}>
          {%- if slide_image -%}
            {{ slide_image | image_url: width: 1600 | image_tag: loading: loading_attr, widths: '750,1100,1600', alt: slide_alt, class: 'hero-slide__img' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hero-slide__img' }}
          {%- endif -%}
          <div class="hero-slide__overlay">
            {%- if block.settings.eyebrow != blank -%}
              <span class="hero-slide__eyebrow">{{ block.settings.eyebrow }}</span>
            {%- endif -%}
            <h2 class="hero-slide__heading">
              {%- if block.settings.heading != blank -%}{{ block.settings.heading }}
              {%- elsif coll.title != blank -%}{{ coll.title }}
              {%- else -%}{{ 'sections.hero.heading' | t }}
              {%- endif -%}
            </h2>
            <span class="btn btn-primary hero-slide__cta">
              {%- if block.settings.cta_label != blank -%}{{ block.settings.cta_label }}{%- else -%}{{ 'sections.hero.cta_primary' | t }}{%- endif -%}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero-slider__dots" data-slider-dots role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="hero-slider__dot{% if forloop.first %} is-active{% endif %}" data-slider-dot data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
    <button type="button" class="hero-slider__arrow hero-slider__arrow--prev" data-slider-prev aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m15 6-6 6 6 6"/></svg>
    </button>
    <button type="button" class="hero-slider__arrow hero-slider__arrow--next" data-slider-next aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
    </button>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Leave blank to use the collection's image or a product photo from it." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "cta_label", "label": "Button label" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
