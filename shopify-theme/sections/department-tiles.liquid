<section class="section section--alt">
  <div class="container">
    <div class="section__head">
      <h2 class="section__title">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'sections.department_tiles.heading' | t }}{% endif %}</h2>
    </div>
    <div class="gender-grid">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        {%- if coll -%}
          <a href="{{ coll.url }}" class="gender-tile" {{ block.shopify_attributes }}>
            <div>
              <div class="gender-tile__name">{{ block.settings.label | default: coll.title }}</div>
              <div class="gender-tile__count">{{ coll.all_products_count }} {{ 'sections.main_collection.product_count' | t }}</div>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Department tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Department tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Custom label", "info": "Leave blank to use the collection title." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Department tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
