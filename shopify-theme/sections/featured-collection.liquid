{%- assign coll = collections[section.settings.collection] -%}

<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="section__title">{{ section.settings.heading | default: coll.title }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="section__desc">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if coll -%}
        <a href="{{ coll.url }}" class="section__link">
          {{ 'sections.featured_collection.view_all' | t }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- if coll -%}
      <div class="product-grid">
        {%- for product in coll.products limit: section.settings.product_count -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
      <div class="section__footer">
        <a href="{{ coll.url }}" class="btn btn-outline">{{ 'sections.featured_collection.view_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
