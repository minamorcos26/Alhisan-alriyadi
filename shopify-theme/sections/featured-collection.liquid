{%- assign coll = collections[section.settings.collection] -%}

<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="section__title">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- elsif product -%}
            {{ 'sections.featured_collection.you_might_also_like' | t }}
          {%- else -%}
            {{ coll.title }}
          {%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="section__desc">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if coll -%}
        <a href="{{ coll.url }}" class="section__link">
          {{ 'sections.featured_collection.view_all' | t }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- if coll -%}
      <div class="product-grid product-grid--6col">
        {%- assign shown_count = 0 -%}
        {%- for item in coll.products limit: 21 -%}
          {%- unless item == product -%}
            {%- if shown_count < 20 -%}
              {%- render 'product-card', product: item -%}
              {%- assign shown_count = shown_count | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
      {%- assign has_more = false -%}
      {%- for item in coll.products offset: 20 limit: 1 -%}
        {%- assign has_more = true -%}
      {%- endfor -%}
      {%- if has_more -%}
        <div class="section__footer">
          <a href="{{ coll.url }}" class="btn btn-outline">{{ 'sections.featured_collection.view_all' | t }}</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
