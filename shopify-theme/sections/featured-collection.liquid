{%- assign coll = collections[section.settings.collection] -%}

<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="section__title">{{ section.settings.heading | default: coll.title }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="section__desc">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if coll -%}
        <a href="{{ coll.url }}" class="section__link">
          {{ 'sections.featured_collection.view_all' | t }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- if coll -%}
      {%- paginate coll.products by section.settings.product_count -%}
        <div data-infinite-scroll data-next-url="{% if paginate.next %}{{ paginate.next.url }}{% endif %}">
          <div class="product-grid" data-infinite-grid>
            {%- for product in coll.products -%}
              {%- render 'product-card', product: product -%}
            {%- endfor -%}
          </div>
          {%- if paginate.next -%}
            <div class="infinite-sentinel" data-infinite-sentinel>
              <span class="infinite-sentinel__spinner" aria-hidden="true"></span>
            </div>
          {%- endif -%}
        </div>
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "label": "Products per page", "min": 4, "max": 12, "step": 4, "default": 8, "info": "More products load automatically as the visitor scrolls." }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
