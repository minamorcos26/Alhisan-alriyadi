{% liquid
  assign main_menu = linklists[section.settings.menu]
  assign dept_paths = '/collections/men,/collections/women,/collections/kids,/collections/sale' | split: ','
%}

<div class="drawer-overlay" data-overlay></div>

<header class="site-header">
  <div class="container site-header__top">
    <button class="icon-btn menu-toggle" data-drawer-open aria-expanded="false" aria-label="{{ 'general.header.menu' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    {%- render 'logo', css_class: 'logo--header' -%}

    <nav class="main-nav" aria-label="Primary">
      {%- for link in main_menu.links -%}
        {%- assign show_in_desktop_nav = false -%}
        {%- if link.url == '/collections' or link.url contains '/policies' or link.url contains '/pages/contact' -%}
          {%- assign show_in_desktop_nav = true -%}
        {%- endif -%}
        {%- if show_in_desktop_nav -%}
          <div class="main-nav__item{% if link.links.size > 0 %} has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="main-nav__link">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <div class="main-nav__dropdown">
                <ul>
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="header-actions">
      {%- if localization.available_languages.size > 1 -%}
        {%- form 'localization', id: 'lang-form-desktop', class: 'lang-toggle lang-toggle--header' -%}
          {%- for language in localization.available_languages -%}
            <button type="submit" name="locale_code" value="{{ language.iso_code }}" aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}">
              {{ language.iso_code | upcase }}
            </button>
          {%- endfor -%}
        {%- endform -%}
      {%- endif -%}

      <a href="{{ routes.search_url }}" class="icon-btn header-actions__search-icon" aria-label="{{ 'general.header.search' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
      </a>
      <a href="{{ routes.account_url }}" class="icon-btn" aria-label="{{ 'general.header.account' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path stroke-linecap="round" d="M4 20c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="icon-btn" aria-label="{{ 'general.header.cart' | t }}" data-cart-drawer-open>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 12.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="9" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="site-header__search-row">
    <div class="container">
      <form action="{{ routes.search_url }}" method="get" role="search" class="header-search">
        <svg class="header-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
        <input type="search" name="q" class="header-search__input" placeholder="{{ 'general.search.placeholder' | t }}" value="{{ search.terms | escape }}" aria-label="{{ 'general.header.search' | t }}">
      </form>
    </div>
  </div>

  <div class="sub-nav">
    <div class="container sub-nav__track">
      <span class="sub-nav__label">{{ 'general.header.shop_by' | t }}</span>
      {%- for link in main_menu.links -%}
        {%- assign is_dept_link = false -%}
        {%- for path in dept_paths -%}
          {%- if link.url contains path -%}{%- assign is_dept_link = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if is_dept_link -%}
          <a href="{{ link.url }}" class="sub-nav__link{% if link.url contains '/collections/sale' %} sub-nav__link--accent{% endif %}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<nav class="mobile-drawer" aria-label="Mobile">
  <div class="drawer-head">
    {%- render 'logo' -%}
    <button class="icon-btn" data-drawer-close aria-label="{{ 'general.header.close_menu' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="drawer-nav">
    {%- for link in main_menu.links -%}
      {%- if link.links.size > 0 -%}
        <div class="drawer-group" data-accordion-group>
          <div class="drawer-group__row">
            <a href="{{ link.url }}" class="drawer-group__title-link">{{ link.title }}</a>
            <button type="button" class="drawer-group__chevron-btn" data-accordion-toggle aria-expanded="false" aria-label="{{ link.title }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="drawer-group__chevron"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
            </button>
          </div>
          <ul class="drawer-group__children">
            {%- for child in link.links -%}
              <li><a href="{{ child.url }}">{{ child.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- else -%}
        <div class="drawer-group drawer-group--flat">
          <a href="{{ link.url }}" class="drawer-group__title-link">{{ link.title }}</a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if localization.available_languages.size > 1 -%}
    {%- form 'localization', id: 'lang-form-mobile', class: 'lang-toggle lang-toggle--drawer' -%}
      {%- for language in localization.available_languages -%}
        <button type="submit" name="locale_code" value="{{ language.iso_code }}" aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}">
          {{ language.iso_code | upcase }}
        </button>
      {%- endfor -%}
    {%- endform -%}
  {%- endif -%}

  {%- render 'social-links', class: 'social-row social-row--drawer' -%}
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
