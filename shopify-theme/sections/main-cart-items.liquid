<div class="container cart-page">
  <h1>{{ 'sections.cart.title' | t }} {%- if cart.item_count > 0 -%}<span class="cart-page__count">({{ cart.item_count }})</span>{%- endif -%}</h1>

  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart, class: 'cart-form' -%}
      <ul class="cart-list">
        {%- for item in cart.items -%}
          <li class="cart-row">
            <a href="{{ item.url }}" class="cart-row__media">
              {%- if item.image -%}
                {{ item.image | image_url: width: 200 | image_tag: alt: item.title, loading: 'lazy' }}
              {%- endif -%}
            </a>

            <div class="cart-row__info">
              <a href="{{ item.url }}" class="cart-row__title">{{ item.product.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <div class="cart-row__variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              {%- if item.quantity > 1 -%}
                <div class="cart-row__unit-price">{{ item.original_price | money_without_trailing_zeros }} {{ 'sections.cart.each' | t }}</div>
              {%- endif -%}
              <a href="{{ item.url_to_remove }}" class="cart-row__remove">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-8 0 1 12a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2l1-12"/></svg>
                {{ 'sections.cart.remove' | t }}
              </a>
            </div>

            <div class="qty-stepper cart-row__qty">
              <button type="button" class="qty-stepper__btn" data-qty-decrease aria-label="Decrease quantity">&minus;</button>
              <input type="number" name="updates[{{ forloop.index0 }}]" value="{{ item.quantity }}" min="0" class="qty-stepper__input">
              <button type="button" class="qty-stepper__btn" data-qty-increase aria-label="Increase quantity">+</button>
            </div>

            <div class="cart-row__total">{{ item.original_line_price | money_without_trailing_zeros }}</div>
          </li>
        {%- endfor -%}
      </ul>

      {%- liquid
        assign subtotal_excl_cents = cart.total_price | divided_by: 1.15 | round
        assign tax_cents = cart.total_price | minus: subtotal_excl_cents
      -%}
      <div class="cart-summary">
        <div class="coupon-form" data-coupon-form data-str-invalid="{{ 'sections.cart.invalid_coupon' | t }}" data-str-empty-coupon="{{ 'sections.cart.empty_coupon' | t }}">
          <input type="text" name="coupon" placeholder="{{ 'sections.cart.coupon_placeholder' | t }}" class="coupon-form__input" autocomplete="off">
          <button type="button" class="btn btn-ghost coupon-form__btn">{{ 'sections.cart.apply' | t }}</button>
        </div>

        <div class="cart-summary__totals-block">
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-summary__totals-row cart-summary__totals-row--discount">
                <span>{{ discount.title }}</span>
                <span>&minus;{{ discount.total_allocated_amount | money_without_trailing_zeros }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
          <div class="cart-summary__totals-row">
            <span>{{ 'sections.cart.subtotal_excl_tax' | t }}</span>
            <span>{{ subtotal_excl_cents | money_without_trailing_zeros }}</span>
          </div>
          <div class="cart-summary__totals-row">
            <span>{{ 'sections.cart.vat' | t }}</span>
            <span>{{ tax_cents | money_without_trailing_zeros }}</span>
          </div>
          <div class="cart-summary__totals-row cart-summary__totals-row--total">
            <span>{{ 'sections.cart.total' | t }}</span>
            <strong>{{ cart.total_price | money_without_trailing_zeros }}</strong>
          </div>
        </div>

        <div class="cart-summary__actions">
          <button type="submit" name="update" class="btn btn-ghost cart-summary__update">{{ 'sections.cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn-primary btn-block">{{ 'sections.cart.checkout' | t }}</button>
        </div>
      </div>
    {%- endform -%}
  {%- else -%}
    <div class="empty-collection">
      <p>{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">{{ 'sections.cart.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart items",
  "settings": []
}
{% endschema %}
