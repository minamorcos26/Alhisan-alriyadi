{%- assign coll = collections[section.settings.collection] -%}

<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="section__title">{{ section.settings.heading | default: coll.title }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="section__desc">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if coll -%}
        <a href="{{ coll.url }}" class="section__link">
          {{ 'sections.featured_collection.view_all' | t }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- if coll -%}
      <div class="product-swiper" data-product-swiper>
        <button type="button" class="product-swiper__arrow product-swiper__arrow--prev" data-swiper-prev aria-label="{{ 'general.pagination.previous' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m15 6-6 6 6 6"/></svg>
        </button>
        <div class="product-swiper__track" data-swiper-track>
          {%- for product in coll.products limit: section.settings.product_count -%}
            <div class="product-swiper__item">
              {%- render 'product-card', product: product -%}
            </div>
          {%- endfor -%}
        </div>
        <button type="button" class="product-swiper__arrow product-swiper__arrow--next" data-swiper-next aria-label="{{ 'general.pagination.next' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product swiper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 4, "max": 20, "step": 1, "default": 12 }
  ],
  "presets": [
    { "name": "Product swiper" }
  ]
}
{% endschema %}
