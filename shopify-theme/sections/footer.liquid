{% liquid
  assign main_menu = linklists[section.settings.shop_menu]
  assign policies_link = nil
  assign contact_link = nil
  for link in main_menu.links
    if link.url contains '/policies'
      assign policies_link = link
    endif
    if link.url contains '/pages/'
      assign contact_link = link
    endif
  endfor
%}

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        {%- render 'logo' -%}
        {%- if section.settings.description != blank -%}
          <p>{{ section.settings.description }}</p>
        {%- endif -%}
        <div class="social-row">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
          {%- endif -%}
          {%- if settings.social_x_link != blank -%}
            <a href="{{ settings.social_x_link }}" aria-label="X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4l16 16M20 4 4 20"/></svg></a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 4v9.5a3.5 3.5 0 1 1-3-3.46M15 4a4 4 0 0 0 4 4"/></svg></a>
          {%- endif -%}
          {%- if settings.social_snapchat_link != blank -%}
            <a href="{{ settings.social_snapchat_link }}" aria-label="Snapchat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.5 0 4.5 2 4.5 4.5 0 1.2 0 2.3.3 3 .3.6 1 .9 1.7 1.1.4.1.5.6.2.9-.4.4-1 .7-1.7.9 0 .4.1.8-.2 1.1-.3.3-1 .3-1.5.3-.4.7-1.2 1.7-3.3 1.7s-2.9-1-3.3-1.7c-.5 0-1.2 0-1.5-.3-.3-.3-.2-.7-.2-1.1-.7-.2-1.3-.5-1.7-.9-.3-.3-.2-.8.2-.9.7-.2 1.4-.5 1.7-1.1.3-.7.3-1.8.3-3C7.5 5 9.5 3 12 3Z"/></svg></a>
          {%- endif -%}
          {%- if settings.social_whatsapp_number != blank -%}
            <a href="https://wa.me/{{ settings.social_whatsapp_number }}" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M4 20l1.3-4A8 8 0 1 1 9 19.6L4 20Z"/></svg></a>
          {%- endif -%}
        </div>
      </div>

      {%- if main_menu -%}
      <div class="footer-col">
        <div class="footer-col__title">{{ 'general.footer.shop' | t }}</div>
        <ul>
          {%- for link in main_menu.links limit: 6 -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}

      {%- if policies_link -%}
      <div class="footer-col">
        <div class="footer-col__title">{{ 'general.footer.help' | t }}</div>
        <ul>
          {%- for link in policies_link.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- if contact_link -%}
            <li><a href="{{ contact_link.url }}">{{ contact_link.title }}</a></li>
          {%- endif -%}
        </ul>
      </div>
      {%- endif -%}

      <div class="footer-col">
        <div class="footer-col__title">{{ 'general.footer.company' | t }}</div>
        <ul>
          {%- if section.settings.about_page != blank -%}
            <li><a href="{{ section.settings.about_page }}">{{ 'general.footer.about' | t }}</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}</span>
      {%- if section.settings.show_payment_icons -%}
        <ul class="payment-icons" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Store description",
      "default": "Your trusted sporting goods store in Saudi Arabia."
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop links menu",
      "default": "main-menu",
      "info": "The Help column is drawn from this menu's \"Policies\" and \"Contact\" items automatically."
    },
    {
      "type": "url",
      "id": "about_page",
      "label": "About page"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}
