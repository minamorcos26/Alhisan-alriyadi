<section class="hero">
  <div class="container hero__grid">
    <div>
      <span class="hero__eyebrow">
        {% if section.settings.eyebrow != blank %}{{ section.settings.eyebrow }}{% else %}{{ 'sections.hero.eyebrow' | t }}{% endif %}
      </span>
      <h1>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'sections.hero.heading' | t }}{% endif %}</h1>
      <p class="hero__sub">{% if section.settings.text != blank %}{{ section.settings.text }}{% else %}{{ 'sections.hero.text' | t }}{% endif %}</p>
      <div class="hero__cta">
        <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="btn btn-primary">
          {% if section.settings.primary_label != blank %}{{ section.settings.primary_label }}{% else %}{{ 'sections.hero.cta_primary' | t }}{% endif %}
        </a>
        {%- if section.settings.secondary_link != blank -%}
          <a href="{{ section.settings.secondary_link }}" class="btn btn-outline">
            {% if section.settings.secondary_label != blank %}{{ section.settings.secondary_label }}{% else %}{{ 'sections.hero.cta_secondary' | t }}{% endif %}
          </a>
        {%- endif -%}
      </div>
      <div class="hero__stats">
        <div class="hero__stat"><b>{{ section.settings.stat_categories_value | default: '57+' }}</b><span>{{ 'sections.hero.stat_categories' | t }}</span></div>
        <div class="hero__stat"><b>{{ section.settings.stat_products_value | default: '1000+' }}</b><span>{{ 'sections.hero.stat_products' | t }}</span></div>
        <div class="hero__stat"><b>{{ 'sections.hero.stat_delivery_value' | t }}</b><span>{{ 'sections.hero.stat_delivery' | t }}</span></div>
      </div>
    </div>
    <div class="hero__collage">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {%- assign loading_attr = 'lazy' -%}
              {%- if forloop.first -%}{%- assign loading_attr = 'eager' -%}{%- endif -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: loading_attr, widths: '350,500,700', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "primary_label", "label": "Primary button label" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "stat_categories_value", "label": "Stat 1 value", "default": "57+" },
    { "type": "text", "id": "stat_products_value", "label": "Stat 2 value", "default": "1000+" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Collage image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
