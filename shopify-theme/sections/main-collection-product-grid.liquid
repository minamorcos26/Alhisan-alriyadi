<div class="container category-layout">
  {%- liquid
    assign availability_filter = nil
    for filter in collection.filters
      if filter.param_name == 'filter.v.availability'
        assign availability_filter = filter
      endif
    endfor
    assign availability_active = false
    if availability_filter
      for value in availability_filter.values
        if value.active
          assign availability_active = true
        endif
      endfor
    endif
  -%}
  <form id="facets" method="get" action="{{ collection.url }}">
    <div>
      <div class="toolbar">
        <div class="toolbar__count"><strong>{{ collection.products_count }}</strong> {{ 'sections.main_collection.results' | t }}</div>
        <div class="toolbar__right">
          <select class="select" aria-label="{{ 'sections.main_collection.sort_by' | t }}" data-sort-select>
            <optgroup label="{{ 'sections.main_collection.sort_by' | t }}">
              {%- for option in collection.sort_options -%}
                <option value="sort:{{ option.value }}" data-sort="{{ option.value }}" {% if option.value == collection.sort_by and availability_active == false %}selected{% endif %}>
                  {%- case option.value -%}
                    {%- when 'manual' -%}{{ 'sections.main_collection.sort_featured' | t }}
                    {%- when 'best-selling' -%}{{ 'sections.main_collection.sort_best_selling' | t }}
                    {%- when 'title-ascending' -%}{{ 'sections.main_collection.sort_title_asc' | t }}
                    {%- when 'title-descending' -%}{{ 'sections.main_collection.sort_title_desc' | t }}
                    {%- when 'price-ascending' -%}{{ 'sections.main_collection.sort_price_asc' | t }}
                    {%- when 'price-descending' -%}{{ 'sections.main_collection.sort_price_desc' | t }}
                    {%- when 'created-descending' -%}{{ 'sections.main_collection.sort_newest' | t }}
                    {%- when 'created-ascending' -%}{{ 'sections.main_collection.sort_oldest' | t }}
                    {%- else -%}{{ option.name }}
                  {%- endcase -%}
                </option>
              {%- endfor -%}
            </optgroup>
            {%- if availability_filter -%}
              <optgroup label="{{ availability_filter.label }}">
                {%- for value in availability_filter.values -%}
                  <option value="avail:{{ value.value }}" data-filter-param="{{ value.param_name }}" data-filter-value="{{ value.value }}" {% if value.active %}selected{% endif %}>{{ value.label }} ({{ value.count }})</option>
                {%- endfor -%}
              </optgroup>
            {%- endif -%}
          </select>
        </div>
      </div>

      {%- paginate collection.products by 24 -%}
        {%- if collection.products.size > 0 -%}
          <div data-infinite-scroll data-next-url="{% if paginate.next %}{{ paginate.next.url }}{% endif %}">
            <div class="product-grid" data-infinite-grid>
              {%- for product in collection.products -%}
                {%- render 'product-card', product: product -%}
              {%- endfor -%}
            </div>
            {%- if paginate.next -%}
              <div class="infinite-sentinel" data-infinite-sentinel>
                <span class="infinite-sentinel__spinner" aria-hidden="true"></span>
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="empty-collection">
            <p>{{ 'sections.main_collection.no_products' | t }}</p>
            <p>{{ 'sections.main_collection.empty_state_text' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline">{{ 'sections.hero.cta_primary' | t }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </form>
</div>

{% schema %}
{
  "name": "Collection product grid",
  "settings": []
}
{% endschema %}
