# Copy to .env and fill in values used by .mcp.json

# 21st.dev MCP server
TWENTYFIRST_API_KEY=

# Figma MCP server (Weavy-AI/figma-mcp-server, deployed to Cloudflare Workers)
# Deploy the repo, set FIGMA_API_KEY as a `wrangler secret` on the Worker,
# then point this at its streamable HTTP endpoint, e.g.:
# https://figma-mcp-server.<your-account>.workers.dev/mcp
FIGMA_MCP_SERVER_URL=
